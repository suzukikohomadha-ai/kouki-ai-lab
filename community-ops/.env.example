# ===== community-ops 設定 =====
# このファイルをコピーして community-ops/.env を作ります（Git管理外）。
# 既存 server/.env（秘書アイ用）とは環境変数名を分けているので、混同しても混線しません。
# 未設定でも各スクリプトは起動しますが、実際のAPI呼び出しはできません（dry-runのみ）。

# --- LINE（告知配信用・公式LINE） ---
# LINE Developers で「実務者のAIエージェント勉強会」用に新規チャネルを作成して取得します。
# 既存の秘書アイ用チャネルとは別チャネルです（絶対に使い回さない）。
LINE_COMMUNITY_CHANNEL_ACCESS_TOKEN=
LINE_COMMUNITY_CHANNEL_SECRET=

# LINE Webhook受信サーバー（webhook-server.mjs）がリッスンするポート
LINE_WEBHOOK_PORT=8090

# 招待リンク・最小実装（scripts/invite-link-gate.gs）のデプロイ済みウェブアプリURL。
# LINE友だち追加時のpopulation A/B自己申告（クイックリプライ）を記録するために使う。
# 未設定でも動作するが、その場合は自己申告の記録だけスキップされる。
INVITE_GATE_URL=

# 「スターターキット」モニター向け はじめかたステップ配信（scripts/onboarding-progress-gate.gs）の
# デプロイ済みウェブアプリURL。モニターごとの進捗（現在のステップ・つまずきカテゴリ）を記録するために使う。
# 未設定でも動作するが、その場合は進捗の記録だけスキップされる（ステップ案内自体はそのまま動く）。
ONBOARDING_PROGRESS_URL=

# --- Discord（加入者特典コミュニティ） ---
# Discord Developer Portal で新規アプリ・Botを作成して取得します。
DISCORD_BOT_TOKEN=
# Botを招待したサーバー（ギルド）のID
DISCORD_GUILD_ID=
