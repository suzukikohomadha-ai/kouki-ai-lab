{
  "name": "accounting-converter",
  "version": "0.0.1",
  "private": true,
  "description": "弥生会計/MFクラウド会計 → freee会計 仕訳CSVコンバータ PoC（ローカル完結・外部通信なし）",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "convert": "tsx src/cli/index.ts convert",
