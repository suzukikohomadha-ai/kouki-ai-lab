    "credit.account":    { "index": "TODO_VERIFY:10" },
    "credit.subAccount": { "index": "TODO_VERIFY:11", "optional": true },
    "credit.department": { "index": "TODO_VERIFY:12", "optional": true },
    "credit.taxCode":    { "index": "TODO_VERIFY:13" },
    "credit.amount":     { "index": "TODO_VERIFY:14" },
    "credit.taxAmount":  { "index": "TODO_VERIFY:15", "optional": true },
