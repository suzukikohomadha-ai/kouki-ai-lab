{
  "_comment": "テスト専用の架空列名。実際のMF仕訳帳CSVのヘッダーではない。",
  "system": "mf_journal",
  "encoding": "auto",
  "delimiter": ",",
  "hasHeader": "auto",
  "headerSignature": ["例_取引No", "例_取引日"],
  "dateFormats": ["YYYY/MM/DD", "YYYY-MM-DD", "YYYY/M/D"],
  "amountMode": "tax_included",
  "grouping": { "strategy": "by_voucher_no" },
  "columns": {
    "voucherNo":         { "header": "例_取引No" },
    "date":              { "header": "例_取引日" },
    "debit.account":     { "header": "例_借方勘定科目" },
    "debit.subAccount":  { "header": "例_借方補助科目", "optional": true },
    "debit.department":  { "header": "例_借方部門", "optional": true },
    "debit.partner":     { "header": "例_借方取引先", "optional": true },
    "debit.taxCode":     { "header": "例_借方税区分" },
    "debit.invoice":     { "header": "例_借方インボイス", "optional": true },
    "debit.amount":      { "header": "例_借方金額" },
    "debit.taxAmount":   { "header": "例_借方税額", "optional": true },
    "credit.account":    { "header": "例_貸方勘定科目" },
    "credit.subAccount": { "header": "例_貸方補助科目", "optional": true },
    "credit.department": { "header": "例_貸方部門", "optional": true },
    "credit.partner":    { "header": "例_貸方取引先", "optional": true },
    "credit.taxCode":    { "header": "例_貸方税区分" },
    "credit.invoice":    { "header": "例_貸方インボイス", "optional": true },
    "credit.amount":     { "header": "例_貸方金額" },
    "credit.taxAmount":  { "header": "例_貸方税額", "optional": true },
    "description":       { "header": "例_摘要" },
    "memo":              { "header": "例_仕訳メモ", "optional": true },
    "tags":              { "header": "例_タグ", "optional": true }
  }
}
