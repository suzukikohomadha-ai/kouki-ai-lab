{
  "version": 1,
  "defaultAction": "memo_tag",
  "rules": [
    { "id": "r01-receivables-to-partner", "when": { "parentAccountIn": ["売掛金", "買掛金", "未収入金", "未払金", "前受金", "前払金", "預り金"] }, "then": { "assign": "partner" } },
    { "id": "r02-bank-branch-to-subaccount", "when": { "parentAccountIn": ["普通預金", "当座預金", "定期預金"] }, "then": { "assign": "freee_sub_account" } },
    { "id": "r03-pattern-department", "when": { "subAccountMatches": "^(本社|支店|営業所|.*部)$" }, "then": { "assign": "department" } },
    { "id": "r99-fallback", "when": {}, "then": { "assign": "memo_tag" } }
  ]
}
